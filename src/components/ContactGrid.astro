---
import { contactLinks, type Lang } from "../data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const emailLink = contactLinks.find((link) => link.icon === "email");
const platformLinks = contactLinks.filter((link) => link.icon !== "email");
const iconSources: Record<string, string> = {
  email: "/icons/contact/qq.svg",
  github: "/icons/contact/github.svg",
  x: "/icons/contact/x.svg",
  bilibili: "/icons/contact/bilibili.svg",
  xiaohongshu: "/icons/contact/xiaohongshu.svg",
  wechat: "/icons/contact/wechat.svg",
  jike: "/icons/contact/jike.png",
  douban: "/icons/contact/douban.svg",
  sspai: "/icons/contact/sspai.ico"
};
---

<div class="contact-grid">
  {platformLinks.map((link) => (
    <a
      class:list={["contact-card", `tone-${link.icon}`]}
      href={link.href}
      target="_blank"
      rel="noreferrer"
    >
      <span class="contact-icon" aria-hidden="true">
        <img src={iconSources[link.icon]} alt="" />
      </span>
      <span class="contact-card-copy">
        <strong>{link.name[lang]}</strong>
      </span>
      <em>{link.action[lang]}</em>
    </a>
  ))}
</div>

{emailLink && (
  <a class="contact-card contact-email-card tone-email" href={emailLink.href}>
    <span class="contact-icon" aria-hidden="true">
      <img src={iconSources.email} alt="" />
    </span>
    <span class="contact-card-copy">
      <strong>{emailLink.handle}</strong>
      <span>{emailLink.name[lang]}</span>
    </span>
    <em>{emailLink.action[lang]}</em>
  </a>
)}
