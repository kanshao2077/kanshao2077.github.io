---
import { categoryLabels, works, type Lang } from "../data/site";

interface Props {
  lang: Lang;
  featuredOnly?: boolean;
}

const { lang, featuredOnly = false } = Astro.props;
const sourceItems = featuredOnly ? works.filter((work) => work.featured) : works;
const pinnedOrder = new Map([
  ["feishu-personal-manual", 0],
  ["ai-writing-after-old-experience", 1]
]);
const optimizedCover = (cover: string, width: 640 | 1200) =>
  cover.replace(/-(?:640|1200)\.webp$/, `-${width}.webp`);
const items = [...sourceItems].sort((left, right) => {
  const priority = (pinnedOrder.get(left.id) ?? Number.MAX_SAFE_INTEGER)
    - (pinnedOrder.get(right.id) ?? Number.MAX_SAFE_INTEGER);

  return priority || Number(Boolean(right.cover)) - Number(Boolean(left.cover));
});
const labels = categoryLabels[lang];
---

{!featuredOnly && (
  <div class="filter-bar" data-work-filters>
    <button class="is-active" type="button" data-filter="all">{labels.all}</button>
    <button type="button" data-filter="aigc">{labels.aigc}</button>
    <button type="button" data-filter="articles">{labels.articles}</button>
    <button type="button" data-filter="vibe">{labels.vibe}</button>
    <button type="button" data-filter="skill">{labels.skill}</button>
  </div>
)}

<div class:list={["work-grid", featuredOnly && "is-featured"]} data-work-grid>
  {items.map((work, index) => {
    const item = work[lang];
    const cover640 = work.cover ? optimizedCover(work.cover, 640) : "";
    const cover1200 = work.cover ? optimizedCover(work.cover, 1200) : "";
    return (
      <article class="work-card" data-category={work.category}>
        <a class="work-cover" href={work.href || "#"} aria-label={item.title}>
          {work.cover ? (
            <img
              src={cover1200}
              srcset={`${cover640} 1x, ${cover1200} 2x`}
              width="1200"
              height="675"
              alt=""
              loading={!featuredOnly && index < 3 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={!featuredOnly && index === 0 ? "high" : "auto"}
            />
          ) : (
            <div class="work-abstract" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
              <strong>{item.title}</strong>
            </div>
          )}
        </a>
        <div class="work-body">
          <div class="work-heading">
            <p>{labels[work.category]}</p>
            <h3>{item.title}</h3>
          </div>
          <p class="work-deck">{item.deck}</p>
          {work.href ? (
            <a class="text-link" href={work.href} target="_blank" rel="noreferrer">{item.cta}</a>
          ) : (
            <span class="text-link is-muted">{item.cta}</span>
          )}
        </div>
      </article>
    );
  })}
</div>

{!featuredOnly && (
  <script>
    const filterRoot = document.querySelector("[data-work-filters]");
    const cards = Array.from(document.querySelectorAll("[data-work-grid] .work-card"));

    filterRoot?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest("button[data-filter]");
      if (!button) return;

      const filter = button.dataset.filter;
      filterRoot.querySelectorAll("button").forEach((item) => item.classList.remove("is-active"));
      button.classList.add("is-active");

      cards.forEach((card) => {
        const visible = filter === "all" || card.dataset.category === filter;
        card.hidden = !visible;
        card.style.display = visible ? "" : "none";
      });
    });
  </script>
)}
